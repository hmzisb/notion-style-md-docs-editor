{
  "name": "@docs/core",
  "version": "0.0.0",
  "description": "Backend-agnostic Markdown docs core: models, contract, tree ops, filesystem semantics, Markdown codec.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "tsup": "8.5.1",
    "vitest": "3.2.7"
  }
}
