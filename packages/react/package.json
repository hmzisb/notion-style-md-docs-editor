{
  "name": "@docs/react",
  "version": "0.0.0",
  "description": "Notion-grade Markdown docs UI for React: tree, viewer, editor, shell and adapters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./adapters/http": {
      "types": "./dist/adapters/http.d.ts",
      "import": "./dist/adapters/http.js"
    },
    "./adapters/filesystem": {
      "types": "./dist/adapters/filesystem.d.ts",
      "import": "./dist/adapters/filesystem.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:css": "tsx ../../scripts/build-css.ts",
    "gen:theme": "tsx ../../scripts/gen-theme.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@docs/core": "workspace:*",
    "@tanstack/query-persist-client-core": "^5.102.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "tw-animate-css": "^1.4.0",
    "vitest": "3.2.7"
  }
}
