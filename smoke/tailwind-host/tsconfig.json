{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "rootDir": ".",
    "outDir": "../../.tsbuild/smoke-tailwind-host",
    "tsBuildInfoFile": "../../.tsbuild/smoke-tailwind-host.tsbuildinfo",
    // A host resolves `@docs/*` the way a stranger does: through the exports map, into
    // `dist`. The workspace path aliases the rest of the repo uses would defeat the point.
    "paths": {}
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts"]
}
