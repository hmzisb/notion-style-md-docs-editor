{
  "name": "docs-module",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm --filter playground test:e2e",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './packages/*' exec publint && pnpm -r --filter './packages/*' exec attw --pack --profile esm-only && size-limit",
    "contract:gen": "tsx packages/core/src/contract/openapi.ts",
    "doctor": "tsx scripts/doctor.ts",
    "smoke": "pnpm -r --filter './smoke/*' build && pnpm -r --filter './smoke/*' test",
    "gate": "tsx scripts/gate.ts",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.5",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "22.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "size-limit": "13.0.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  }
}
