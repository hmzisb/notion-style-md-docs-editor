{
  "name": "docs-module",
  "private": true,
  "description": "Notion-grade Markdown docs module for React: tree, editor, cache, adapters — backend-agnostic, plus a playground.",
  "license": "MIT",
  "author": "hmzisb",
  "homepage": "https://github.com/hmzisb/notion-style-md-docs-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmzisb/notion-style-md-docs-editor.git"
  },
  "bugs": {
    "url": "https://github.com/hmzisb/notion-style-md-docs-editor/issues"
  },
  "keywords": [
    "markdown",
    "docs",
    "notion",
    "editor",
    "react",
    "platejs",
    "wiki",
    "wysiwyg",
    "knowledge-base"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:perf": "vitest run --config fixtures/vitest.perf.config.ts",
    "test:e2e": "pnpm --filter playground test:e2e",
    "test:e2e:perf": "pnpm --filter playground test:e2e:perf",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './packages/*' exec publint && pnpm -r --filter './packages/*' exec attw --pack --profile esm-only && size-limit",
    "contract:gen": "tsx packages/core/src/contract/openapi.ts",
    "perf:gen": "tsx fixtures/perf/gen.ts",
    "doctor": "tsx --tsconfig tsconfig.tools.json scripts/doctor.ts",
    "a11y:lighthouse": "tsx --tsconfig tsconfig.tools.json scripts/lighthouse-a11y.ts",
    "smoke": "pnpm -r --filter './smoke/*' build && pnpm -r --filter './smoke/*' test",
    "gate": "tsx scripts/gate.ts",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.39.5",
    "@size-limit/preset-small-lib": "13.0.3",
    "@types/node": "22.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "size-limit": "13.0.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  }
}
